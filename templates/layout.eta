<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.siteTitle %><% if (it.pageTitle) { %> | <%= it.pageTitle %><% } %></title>
  <link rel="stylesheet" href="<%= it.basePath %>style.css">
</head>
<body>
  <div class="app-layout">
    <nav class="sidebar">
      <a href="<%= it.basePath || './' %>" class="nav-title"><%= it.siteTitle %></a>
      <ul class="nav-links">
        <% it.repos.slice().sort(function(a, b) { return a.name.localeCompare(b.name); }).forEach(function(repo) { %>
          <li>
            <a href="<%= it.basePath %><%= repo.name %>/"
               <% if (it.activeRepo === repo.name) { %>class="active"<% } %>>
              <%= repo.name %>
            </a>
          </li>
        <% }) %>
      </ul>
    </nav>
    <div class="main-area">
      <main class="content">
        <%~ it.body %>
      </main>
      <footer class="site-footer">
        <p>Generated at <%= it.generatedAt %></p>
      </footer>
    </div>
    <% if (it.developers && it.developers.length > 0) { %>
    <aside class="sidebar-right">
      <span class="sidebar-right-title">Developers</span>
      <ul class="dev-links">
        <% it.developers.forEach(function(dev) { %>
          <li>
            <a href="<%= it.basePath %>developer/<%= dev.login %>/"
               class="dev-link<% if (it.activeDeveloper === dev.login) { %> active<% } %>">
              <img src="<%= dev.avatarUrl %>&s=32" alt="" class="dev-avatar" width="20" height="20" loading="lazy">
              <span class="dev-login"><%= dev.login %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </aside>
    <% } %>
  </div>
</body>
</html>
